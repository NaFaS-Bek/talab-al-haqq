{
  "name": "talab-al-haqq",
  "main": "worker-review.mjs",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "preview_urls": false,
  "build": {
    "command": "python3 tool/prepare_website.py --build build/website"
  },
  "assets": {
    "directory": "./build/website",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
