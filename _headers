# Talab al-Haqq: conservative defense-in-depth for static Workers assets.
# Source: https://developers.cloudflare.com/workers/static-assets/headers/
# Does not alter religion texts or impose script-src/style-src restrictions on
# the many educational pages that still contain inline JS/CSS.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Content-Security-Policy: base-uri 'none'; object-src 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=()
